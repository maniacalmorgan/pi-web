# Copy to .env and load it explicitly:  node --env-file=.env server.mjs
# (The server does not read .env by itself — see README "Configuration".)

# Where the UI listens.
PI_WEB_PORT=4321
# auto | tailscale | lan | localhost | an IP or hostname
PI_WEB_HOST=auto

# Working directory the agent runs in (what it can read and edit).
# PI_WEB_CWD=/home/you

# Path to the pi binary, if it is not on PATH.
# PI_BIN=/usr/local/bin/pi

# Override only if you keep pi's sessions somewhere non-standard.
# PI_SESSIONS_DIR=/home/you/.pi/agent/sessions

# VAPID keys + push subscriptions (created on first run, keep out of git).
# PI_WEB_DATA_DIR=./data

# Opt-in shared secret. Strongly recommended if the port is reachable by anything
# you do not fully trust. Generate one with: openssl rand -hex 24
# PI_WEB_TOKEN=
